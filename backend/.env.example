# Copy to backend/.env and fill in. Never commit the real .env, and never put real keys in this example file.
PORT=4000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173
DATA_DIR=./data

# Synthetic data only. When true, both sources are replaced by locally generated, clearly labelled records.
DEMO_MODE=false

# ---------- Video sources (Apify free plan: about $5 of usage per month) ----------
APIFY_TOKEN=your_apify_token_here
APIFY_INSTAGRAM_ACTOR=apify~instagram-hashtag-scraper
# Reels from the brand's official account, only when Gemini names a handle that matches the brand.
APIFY_INSTAGRAM_REEL_ACTOR=apify~instagram-reel-scraper
INSTAGRAM_BRAND_REELS=true
INSTAGRAM_HASHTAGS_PER_RUN=4
APIFY_META_ACTOR=apify~facebook-ads-scraper
META_QUERIES_PER_ROUND=2
APIFY_RUN_TIMEOUT_SECS=180
# Free-tier guard: max provider items fetched per source per search.
MAX_PROVIDER_ITEMS_PER_SOURCE=450
APIFY_DUMP_RAW=false

# Meta provider: apify (thumbnails + video files) or graph (official Ad Library API, metadata only)
META_PROVIDER=apify
META_ACCESS_TOKEN=
META_GRAPH_VERSION=v23.0
META_AD_COUNTRIES=ALL

# ---------- Relevance ----------
# 0-100. A video counts toward the 20 only at or above this score.
MATCH_THRESHOLD=55
# auto: brand + model typed -> exact product (or colour/size variant); brand only -> that brand's product type;
# generic name ("tumbler") -> any product of that type. Or force: exact | brand | category
MATCH_SCOPE=auto

# ---------- Image brain ----------
VISION_BACKEND=clip
CLIP_MODEL=Xenova/clip-vit-base-patch32
CLIP_IMAGE_COS_LOW=0.5
CLIP_IMAGE_COS_HIGH=0.78

# Gemini (free tier). Create a key at https://aistudio.google.com/apikey - it starts with "AIza".
# Google Cloud / Vertex AI express keys ("AQ.") also work: GEMINI_ENDPOINT=auto tries both endpoints.
GEMINI_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
# Free-tier quota is per model: when one is exhausted or retired, the next one is used.
GEMINI_FALLBACK_MODELS=gemini-3.8-flash
# Also add Flash models this key can use (Models API listing is free and uses no generation quota).
GEMINI_DISCOVER_MODELS=true
GEMINI_ENDPOINT=auto
GEMINI_TIMEOUT_MS=35000
GEMINI_REQUEST_RETRIES=1
GEMINI_MAX_OUTPUT_TOKENS=4096

# Verification of candidates by the vision-language model. Keep this on: it is what makes results exact.
VLM_VERIFY=true
VLM_BATCH_SIZE=10
VLM_MAX_CALLS_PER_SEARCH=12
VLM_SEND_FLOOR=0.3

# Optional second free verifier with an OpenAI-compatible API, used when Gemini's quota runs out.
# Example (Groq free tier): base URL https://api.groq.com/openai/v1, a vision model, max 5 images per request.
VLM_FALLBACK_BASE_URL=
VLM_FALLBACK_API_KEY=
VLM_FALLBACK_MODEL=
VLM_FALLBACK_MAX_IMAGES=5

# Paid; leave empty to stay free.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Frame sampling (ffmpeg-static is installed with npm; FFMPEG_PATH overrides it)
FRAME_SAMPLING=true
FFMPEG_PATH=
FRAME_COUNT=5
FRAME_EVERY_SECONDS=3
FRAME_MAX_VIDEO_MB=40
FRAME_MAX_PER_BATCH=8
FRAME_CONFIDENT_ABOVE=0.85

# De-duplication
NEAR_DUPLICATE_HAMMING=8
NEAR_DUPLICATE_MIN_COLOUR=0.9

# Pipeline limits
MIN_RESULTS_PER_SOURCE=20
MAX_ROUNDS_PER_SOURCE=8
MAX_RETRYABLE_ERRORS=3
INSTAGRAM_SOURCE_TIMEOUT_MS=600000
META_SOURCE_TIMEOUT_MS=480000
ANALYSIS_FAILURE_CACHE_MS=300000
REQUEST_RETRIES=2
JOB_CONCURRENCY=1
PRODUCT_CACHE_TTL_HOURS=24
